:root{

    --primary:#2563eb;
    --secondary:#7c3aed;
    --success:#10b981;

    --background:#f8fafc;
    --white:#ffffff;

    --text:#1f2937;
    --text-light:#6b7280;

    --shadow:0 10px 30px rgba(0,0,0,.08);

    --radius:16px;

}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{

    scroll-behavior:smooth;

}

body{

    font-family:"Poppins",sans-serif;

    background:var(--background);

    color:var(--text);

    line-height:1.7;

}

.container{

    width:90%;

    max-width:1200px;

    margin:auto;

}



header{

    position:fixed;

    top:0;

    left:0;

    width:100%;

    background:white;

    box-shadow:var(--shadow);

    z-index:1000;

}

header .container{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px 0;

}

.logo{

    display:flex;

    align-items:center;

    gap:12px;

}

.logo i{

    color:var(--primary);

    font-size:34px;

}

.logo h2{

    font-size:24px;

    font-weight:700;

}

nav ul{

    display:flex;

    list-style:none;

    gap:35px;

}

nav a{

    text-decoration:none;

    color:var(--text);

    font-weight:500;

    transition:.3s;

}

nav a:hover{

    color:var(--primary);

}

.btn-header{

    background:var(--primary);

    color:white;

    padding:12px 24px;

    border-radius:50px;

    text-decoration:none;

    transition:.3s;

}

.btn-header:hover{

    background:var(--secondary);

}

#menu-mobile{

    display:none;

}



.hero{

    padding-top:150px;

    padding-bottom:100px;

}

.hero-container{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:70px;

    align-items:center;

}

.tag{

    display:inline-block;

    padding:8px 18px;

    background:#dbeafe;

    color:var(--primary);

    border-radius:50px;

    font-weight:600;

    margin-bottom:20px;

}

.hero h1{

    font-size:56px;

    line-height:1.2;

    margin-bottom:25px;

}

.hero p{

    color:var(--text-light);

    margin-bottom:35px;

    font-size:18px;

}

.hero-buttons{

    display:flex;

    gap:20px;

}

.btn-primary{

    text-decoration:none;

    background:var(--primary);

    color:white;

    padding:15px 35px;

    border-radius:50px;

    transition:.3s;

    font-weight:600;

}

.btn-primary:hover{

    transform:translateY(-4px);

    background:var(--secondary);

}

.btn-secondary{

    text-decoration:none;

    border:2px solid var(--primary);

    color:var(--primary);

    padding:15px 35px;

    border-radius:50px;

    transition:.3s;

}

.btn-secondary:hover{

    background:var(--primary);

    color:white;

}



.mockup{

    background:white;

    border-radius:25px;

    overflow:hidden;

    box-shadow:var(--shadow);

}

.topo{

    display:flex;

    gap:10px;

    padding:18px;

    background:#eef2ff;

}

.bolinha{

    width:14px;

    height:14px;

    border-radius:50%;

}

.vermelho{

    background:#ef4444;

}

.amarelo{

    background:#f59e0b;

}

.verde{

    background:#22c55e;

}

.conteudo{

    display:grid;

    grid-template-columns:1fr;

    gap:20px;

    padding:30px;

}

.card-dashboard{

    background:#f9fafb;

    border-radius:16px;

    padding:30px;

    text-align:center;

    transition:.4s;

}

.card-dashboard:hover{

    transform:translateY(-8px);

}

.card-dashboard i{

    font-size:40px;

    color:var(--primary);

    margin-bottom:15px;

}

.card-dashboard h3{

    font-size:28px;

    margin-bottom:10px;

}



.problema{

    padding:100px 0;

}

.problema h2{

    text-align:center;

    font-size:42px;

    margin-bottom:60px;

}

.cards-problema{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:35px;

}

.card{

    background:var(--white);

    padding:40px;

    border-radius:var(--radius);

    box-shadow:var(--shadow);

    transition:.4s;

}

.card:hover{

    transform:translateY(-10px);

}

.card i{

    font-size:55px;

    margin-bottom:20px;

}

.problema-card i{

    color:#ef4444;

}

.solucao-card i{

    color:var(--success);

}

.card h3{

    margin-bottom:18px;

    font-size:24px;

}

.card p{

    color:var(--text-light);

}



.funcionalidades{

    padding:110px 0;

    background:#eef5ff;

}

.titulo{

    text-align:center;

    margin-bottom:60px;

}

.titulo span{

    color:var(--primary);

    font-weight:600;

    text-transform:uppercase;

}

.titulo h2{

    font-size:42px;

    margin:15px 0;

}

.titulo p{

    color:var(--text-light);

}

.cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

    gap:30px;

}

.cards .card{

    text-align:center;

}

.cards .card i{

    color:var(--primary);

    font-size:55px;

    margin-bottom:20px;

}

.cards .card:hover{

    background:var(--primary);

    color:white;

}

.cards .card:hover p{

    color:#dbeafe;

}

.cards .card:hover i{

    color:white;

}



.usuarios{

    padding:110px 0;

}

.usuarios-grid{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:30px;

}

.usuario-card{

    background:white;

    border-radius:20px;

    padding:40px;

    text-align:center;

    box-shadow:var(--shadow);

    transition:.4s;

}

.usuario-card:hover{

    transform:translateY(-10px);

}

.usuario-card i{

    font-size:60px;

    color:var(--secondary);

    margin-bottom:20px;

}

.usuario-card h3{

    margin-bottom:15px;

    font-size:24px;

}

.usuario-card p{

    color:var(--text-light);

}



.cta-final{

    padding:100px 0;

    background:linear-gradient(
    135deg,
    var(--primary),
    var(--secondary));

    text-align:center;

    color:white;

}

.cta-final h2{

    font-size:44px;

    margin-bottom:20px;

}

.cta-final p{

    margin-bottom:35px;

    font-size:18px;

}

.cta-final .btn-primary{

    background:white;

    color:var(--primary);

}

.cta-final .btn-primary:hover{

    background:#f3f4f6;

}



.contato{

    padding:110px 0;

    background:#f8fafc;

}

.contato form{

    max-width:700px;

    margin:50px auto 0;

    display:flex;

    flex-direction:column;

    gap:20px;

}

.contato input,
.contato textarea{

    width:100%;

    padding:18px;

    border:1px solid #d1d5db;

    border-radius:12px;

    font-size:16px;

    outline:none;

    transition:.3s;

    font-family:"Poppins",sans-serif;

}

.contato input:focus,
.contato textarea:focus{

    border-color:var(--primary);

    box-shadow:0 0 0 4px rgba(37,99,235,.15);

}

.contato textarea{

    resize:none;

}

.contato button{

    border:none;

    cursor:pointer;

}



footer{

    background:#111827;

    color:white;

    padding-top:70px;

}

.footer-container{

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:60px;

    padding-bottom:50px;

}

.footer-container h3{

    margin-bottom:20px;

    font-size:26px;

}

.footer-container h4{

    margin-bottom:20px;

}

.footer-container p{

    color:#d1d5db;

}

.footer-container ul{

    list-style:none;

}

.footer-container li{

    margin-bottom:15px;

}

.footer-container a{

    color:#d1d5db;

    text-decoration:none;

    transition:.3s;

}

.footer-container a:hover{

    color:white;

}

.copyright{

    text-align:center;

    padding:25px;

    border-top:1px solid rgba(255,255,255,.08);

    color:#9ca3af;

}



.card,
.usuario-card,
.card-dashboard{

    animation:fadeUp .8s ease;

}

@keyframes fadeUp{

    from{

        opacity:0;

        transform:translateY(30px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}



@media(max-width:992px){

.hero-container{

grid-template-columns:1fr;

text-align:center;

}

.hero-buttons{

justify-content:center;

}

.cards-problema{

grid-template-columns:1fr;

}

.usuarios-grid{

grid-template-columns:1fr;

}

.footer-container{

grid-template-columns:1fr;

text-align:center;

}

}

@media(max-width:768px){

nav ul{

display:none;

}

#menu-mobile{

display:block;

background:none;

border:none;

font-size:28px;

cursor:pointer;

color:var(--primary);

}

.logo h2{

font-size:20px;

}

.hero{

padding-top:130px;

}

.hero h1{

font-size:38px;

}

.hero p{

font-size:16px;

}

.hero-buttons{

flex-direction:column;

}

.btn-primary,
.btn-secondary{

width:100%;

text-align:center;

}

.cards{

grid-template-columns:1fr;

}

}

@media(max-width:480px){

.container{

width:92%;

}

.hero h1{

font-size:32px;

}

.titulo h2{

font-size:30px;

}

.problema h2{

font-size:30px;

}

.cta-final h2{

font-size:32px;

}

.card{

padding:25px;

}

.usuario-card{

padding:25px;

}

}
